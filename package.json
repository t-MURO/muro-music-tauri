{
  "name": "muro-music-tauri",
  "private": true,
  "version": "0.1.10",
  "license": "AGPL-3.0-or-later",
  "description": "A customizable desktop music library and player",
  "author": "Muro Music contributors",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "test:portable": "node tests/beatgrid-smoke.mjs && node tests/mixplan-smoke.mjs && node tests/artist-separator-smoke.mjs && node tests/i18n-smoke.mjs && node tests/loudness-smoke.mjs && node tests/playback-guard-smoke.mjs",
    "check": "npm run typecheck && npm run test:portable"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.542.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.3.1"
  }
}
